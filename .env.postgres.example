# Fig PostgreSQL Environment Configuration
# Copy this file to .env.postgres and fill in the values for your deployment.
# IMPORTANT: Never commit the .env.postgres file to source control.
#
# Usage:
#   cp .env.postgres.example .env.postgres
#   docker compose -f docker-compose.postgres.yml --env-file .env.postgres up

# Database name for Fig
FIG_DB_NAME=fig

# Database login username
FIG_USER_NAME=fig_login

# Database password — generate a strong, unique password
FIG_DB_PWD=<GENERATE-A-STRONG-PASSWORD>

# PostgreSQL superuser password (used for initial container setup)
POSTGRES_PASSWORD=<SET-POSTGRES-PASSWORD>

# Optional MCP credentials (defaults shown)
# FIG_MCP_USERNAME=admin
# FIG_MCP_PASSWORD=<GENERATE-A-STRONG-PASSWORD>
