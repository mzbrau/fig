@using Fig.Web.Dashboards
@using Fig.Web.Notifications
@using Microsoft.JSInterop
@using Radzen
@inject IJSRuntime JsRuntime
@inject NotificationService NotificationService
@inject INotificationFactory NotificationFactory

<div class="dashboard-data-explorer__node" style="--depth: @Depth">
    <div class="dashboard-data-explorer__row">
        <button type="button"
                class="dashboard-data-explorer__toggle"
                @onclick="Toggle"
                disabled="@(!Node.HasChildren)"
                title="@(Node.HasChildren ? (_expanded ? "Collapse" : "Expand") : null)">
            <span class="dashboard-data-explorer__chevron">
                @if (Node.HasChildren)
                {
                    <RadzenIcon Icon="@(_expanded ? "expand_more" : "chevron_right")" />
                }
            </span>
            <span class="dashboard-data-explorer__name">@Node.Name</span>
            @if (!string.IsNullOrEmpty(Node.Value))
            {
                <span class="dashboard-data-explorer__value" title="@Node.Value">@Node.Value</span>
            }
            <span class="dashboard-data-explorer__type">@Node.Type</span>
        </button>
        <button type="button"
                class="dashboard-data-explorer__copy"
                title="@($"Copy {Node.Path}")"
                @onclick="CopyPathAsync"
                @onclick:stopPropagation="true">
            <RadzenIcon Icon="content_copy" />
        </button>
    </div>
    @if (_expanded && Node.HasChildren)
    {
        foreach (var child in Node.Children)
        {
            <DashboardDataExplorerNodeView Node="child" Depth="Depth + 1" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public DashboardDataExplorerNode Node { get; set; } = null!;

    [Parameter] public int Depth { get; set; }

    private bool _expanded;
    private bool _initialized;

    protected override void OnParametersSet()
    {
        if (_initialized)
            return;

        // Expand top two levels by default for discoverability.
        _expanded = Depth < 2;
        _initialized = true;
    }

    private void Toggle()
    {
        if (!Node.HasChildren)
            return;
        _expanded = !_expanded;
    }

    private async Task CopyPathAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Node.Path);
            NotificationService.Notify(NotificationFactory.Success("Copied", Node.Path));
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationFactory.Warning(
                "Copy failed",
                "Could not write to the clipboard. Check browser permissions and try again."));
        }
    }
}
