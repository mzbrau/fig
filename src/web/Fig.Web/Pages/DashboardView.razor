@page "/dashboards/{Id:guid}"
@using Fig.Web.Attributes
@using Fig.Web.Dashboards.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@attribute [DashboardOnly]

<PageTitle>Fig - @(_dashboard?.Name ?? "Dashboard")</PageTitle>

@if (_loading)
{
    <div class="text-center p-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                   Size="ProgressBarCircularSize.Large" />
    </div>
}
else if (_dashboard is null)
{
    <div class="p-4">
        <RadzenAlert AlertStyle="AlertStyle.Danger" Title="Not found" Text="Dashboard was not found or you do not have access." />
        <RadzenButton Text="Back to list" Icon="arrow_back" Click="@GoToList" ButtonStyle="ButtonStyle.Light" />
    </div>
}
else
{
    <div class="dashboard-view @(_wallboard ? "dashboard-view--wallboard" : null)">
        @if (ShowStatusBar)
        {
            <div class="dashboard-view__status-bar">
                <div class="dashboard-view__status-bar-left">
                    <img class="dashboard-view__status-bar-logo"
                         src="images/fig_logo_name_right_white_299x135.png"
                         alt="Fig"
                         width="72"
                         height="32" />
                    <span class="dashboard-view__status-bar-name">@_dashboard.Name</span>
                    <span class="dashboard-view__status-bar-cache text-muted">
                        Status cached: @FormatCache(DataProvider.StatusLastRefreshUtc)
                        · Settings cached: @FormatCache(DataProvider.SettingsLastRefreshUtc)
                    </span>
                </div>
                <div class="dashboard-view__status-bar-right">
                    <ConnectionStatus ShowStaleStatus="false" />
                    @if (_wallboard)
                    {
                        <RadzenButton Icon="fullscreen_exit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                                      Text="Exit wallboard" Click="@ToggleWallboard" title="Exit wallboard (Esc)" />
                    }
                </div>
            </div>
        }

        @if (!_wallboard)
        {
            <div class="dashboard-view__toolbar">
                @if (!IsDashboardRole)
                {
                    <div class="dashboard-view__title-block">
                        <h2 class="mb-0">@_dashboard.Name</h2>
                        @if (!string.IsNullOrWhiteSpace(_dashboard.Description))
                        {
                            <p class="mb-0 text-muted">@_dashboard.Description</p>
                        }
                    </div>
                }
                <div class="dashboard-view__actions d-flex flex-wrap gap-2 @(IsDashboardRole ? "ms-auto" : null)">
                    <RadzenButton Text="Refresh status" Icon="sync" Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light" IsBusy="_refreshingStatus"
                                  Click="@RefreshStatus" />
                    <RadzenButton Text="Refresh settings" Icon="settings_suggest" Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light" IsBusy="_refreshingSettings"
                                  Click="@RefreshSettings" />
                    <RadzenButton Text="Wallboard"
                                  Icon="fullscreen"
                                  Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                                  Click="@ToggleWallboard" />
                    <RadzenButton Text="Export HTML" Icon="download" Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light" IsBusy="_exporting"
                                  Click="@ExportHtml" />
                    @if (IsAdmin)
                    {
                        <RadzenButton Text="Edit" Icon="edit" Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary" Click="@GoToEdit" />
                    }
                    <RadzenButton Text="All dashboards" Icon="list" Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light" Click="@GoToList" />
                </div>
            </div>
            @if (!IsDashboardRole)
            {
                <div class="dashboard-view__meta text-muted mb-2">
                    Status cached: @FormatCache(DataProvider.StatusLastRefreshUtc)
                    · Settings cached: @FormatCache(DataProvider.SettingsLastRefreshUtc)
                </div>
            }
        }

        <div @ref="_viewRoot" tabindex="0" class="dashboard-view__focus-host"
             @onkeydown="OnViewKeyDown">
            <DashboardGridHost Layout="_dashboard.Definition.Layout"
                               Components="_dashboard.Definition.Components"
                               Results="_results" />
        </div>
    </div>
}
